# --- Server ---
DOCKTORNET_LISTEN=0.0.0.0:5363
DOCKTORNET_SECRET=changeme-please
DOCKTORNET_DB_PATH=./data/docktornet.db
DOCKTORNET_FULL_RESYNC_INTERVAL=1h
DOCKTORNET_GATUS_CONFIG_DIR=/etc/gatus/config
DOCKTORNET_DRY_RUN=true
DOCKTORNET_ADOPT_EXISTING=false

DOCKTORNET_NPM_URL=http://npm:81
DOCKTORNET_NPM_USER=admin@example.com
DOCKTORNET_NPM_PASSWORD=changeme
# Address NPM will use to reach proxied containers (usually the docker host's LAN IP).
DOCKTORNET_NPM_FORWARD_HOST=127.0.0.1

DOCKTORNET_CF_API_TOKEN=...
DOCKTORNET_CF_ZONE_ID=...

# --- Agent ---
DOCKTORNET_SERVER_URL=http://127.0.0.1:5363
# DOCKTORNET_SECRET=changeme-please       # share with server
DOCKTORNET_POLL_INTERVAL=30s
DOCKTORNET_MACHINE_ID=batterdock
DOCKTORNET_SOCKETS=docker:/var/run/docker.sock
