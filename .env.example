# --- Server ---
DOCKTORNET_LISTEN=0.0.0.0:5363                    # required
DOCKTORNET_SECRET=changeme-please                 # required; agent must use the same value
DOCKTORNET_DB_PATH=/data/docktornet.db            # required; absolute, on the ./data:/data volume
DOCKTORNET_GATUS_CONFIG_DIR=/etc/gatus/config     # required
DOCKTORNET_FULL_RESYNC_INTERVAL=1h                # optional (default: 1h)
DOCKTORNET_DRY_RUN=true                           # optional (default: true) — set false to allow external writes
DOCKTORNET_ADOPT_EXISTING=false                   # optional (default: false) — adopt CF records that already exist

DOCKTORNET_NPM_URL=http://npm:81                  # required
DOCKTORNET_NPM_USER=admin@example.com             # required
DOCKTORNET_NPM_PASSWORD=changeme                  # required

DOCKTORNET_CF_API_TOKEN=...                       # required
DOCKTORNET_CF_ZONE_ID=...                         # required

# --- Agent ---
DOCKTORNET_SERVER_URL=http://127.0.0.1:5363       # required
# DOCKTORNET_SECRET=changeme-please               # required; share with server (commented when both roles run from one .env)
DOCKTORNET_POLL_INTERVAL=30s                      # required
DOCKTORNET_MACHINE_ID=batterdock                  # required
# This machine's address that NPM uses to reach its containers (usually its LAN IP).
DOCKTORNET_FORWARD_HOST=127.0.0.1                 # required
DOCKTORNET_SOCKETS=docker:/var/run/docker.sock    # required
