# Server settings. Copy to server.env: next to the compose file when deploying, or
# at the repository root for `just run-server`.
DOCKTORNET_LISTEN=0.0.0.0:5363                    # required
DOCKTORNET_SECRET=changeme                        # required; at least 32 characters, generate with `openssl rand -hex 32`; every agent uses the same value
DOCKTORNET_DB_PATH=/data/docktornet.db            # absolute, on a volume; the server image sets this, required outside it
# DOCKTORNET_ALLOW_EPHEMERAL_DB=false             # optional (default: false) — true starts even with the database in the container layer
DOCKTORNET_GATUS_CONFIG_DIR=/etc/gatus/config.d   # required
DOCKTORNET_FULL_RESYNC_INTERVAL=1h                # optional (default: 1h)
DOCKTORNET_DRY_RUN=true                           # optional (default: true) — set false to allow external writes
DOCKTORNET_ADOPT_EXISTING=false                   # optional (default: false) — adopt CF records that already exist

DOCKTORNET_NPM_URL=http://npm:81                  # required
DOCKTORNET_NPM_USER=admin@example.com             # required
DOCKTORNET_NPM_PASSWORD=changeme                  # required

DOCKTORNET_CF_API_TOKEN=...                       # required
DOCKTORNET_CF_ZONE_ID=...                         # required

# Caddy is optional; leave both unset to turn it off. See "Caddy" in docs/deployment.md.
# DOCKTORNET_CADDY_ADMIN_URL=http://caddy:2019    # optional; Caddy's admin API, on a network shared only with this server
# DOCKTORNET_CADDY_ANCHOR_ID=docktornet           # optional (default: docktornet); the @id of the anchor route
